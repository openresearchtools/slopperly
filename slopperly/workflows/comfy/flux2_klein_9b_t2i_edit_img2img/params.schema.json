            "node": "27",
            "input": "latent"
          },
          {
            "node": "28",
            "input": "latent"
          }
        ]
      }
    ]
  },
  "unmapped_ui_parameters": {
    "frames": "The existing image-plugin frame control is preserved by the surrounding UI but this workflow emits one PNG per generate call.",
    "strength": "The official FLUX.2 Klein reference-edit graph does not expose a denoise/strength input; the plugin records a usage note when image edit is used.",
    "inpaint_mask": "Masked inpaint is blocked until an official local FLUX.2 Klein mask workflow is certified."
