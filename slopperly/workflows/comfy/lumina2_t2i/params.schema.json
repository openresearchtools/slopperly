{
  "version": 1,
  "workflow_id": "lumina2_t2i",
  "description": "Patch schema for Lumina-Image 2.0 text-to-image through Comfy core Lumina nodes and a GGUF diffusion backbone.",
  "inputs": {
    "lumina_model": [
      {
        "node": "1",
        "input": "unet_name"
      }
    ],
    "lumina_shift": [
      {
        "node": "2",
        "input": "shift"
      }
    ],
    "lumina_text_encoder": [
      {
        "node": "3",
        "input": "clip_name"
      }
    ],
    "lumina_system_prompt": [
      {
        "node": "4",
        "input": "system_prompt"
      }
    ],
    "prompt": [
      {
        "node": "4",
        "input": "user_prompt"
      }
    ],
    "negative_prompt": [
      {
        "node": "5",
        "input": "text"
      }
    ],
    "width": [
      {
        "node": "6",
        "input": "width"
      }
    ],
    "height": [
      {
        "node": "6",
        "input": "height"
      }
    ],
    "batch": [
      {
        "node": "6",
        "input": "batch_size"
      }
    ],
    "seed": [
      {
        "node": "7",
        "input": "seed"
      }
    ],
    "steps": [
      {
        "node": "7",
        "input": "steps"
      }
    ],
    "guidance": [
      {
        "node": "7",
        "input": "cfg"
      }
    ],
    "lumina_sampler": [
      {
        "node": "7",
        "input": "sampler_name"
      }
    ],
    "lumina_scheduler": [
      {
        "node": "7",
        "input": "scheduler"
      }
    ],
    "lumina_denoise": [
      {
        "node": "7",
        "input": "denoise"
      }
    ],
    "lumina_vae": [
      {
        "node": "8",
        "input": "vae_name"
      }
    ]
  },
  "uploads": {},
  "outputs": [
    {
      "node": "10",
      "type": "image",
      "extension": ".png",
      "mime": "image/png"
    }
  ],
  "notes": [
    "The existing prompt field maps to CLIPTextEncodeLumina2 user_prompt with the superior Lumina system prompt.",
    "The existing negative prompt field maps to a regular CLIPTextEncode negative conditioning node.",
    "The workflow follows Comfy's Lumina basic example with AuraFlow sampling shift, but uses a Slopperly-derived Q5_K_M GGUF diffusion backbone plus split Gemma text encoder and Lumina VAE."
  ]
}
