{
  "version": 1,
  "workflow_id": "lumina2_t2i",
  "description": "Patch schema for Lumina-Image 2.0 text-to-image through Comfy core Lumina nodes.",
  "inputs": {
    "lumina_checkpoint": [
      {
        "node": "1",
        "input": "ckpt_name"
      }
    ],
    "lumina_shift": [
      {
        "node": "2",
        "input": "shift"
      }
    ],
    "lumina_system_prompt": [
      {
        "node": "3",
        "input": "system_prompt"
      }
    ],
    "prompt": [
      {
        "node": "3",
        "input": "user_prompt"
      }
    ],
    "negative_prompt": [
      {
        "node": "4",
        "input": "text"
      }
    ],
    "width": [
      {
        "node": "5",
        "input": "width"
      }
    ],
    "height": [
      {
        "node": "5",
        "input": "height"
      }
    ],
    "batch": [
      {
        "node": "5",
        "input": "batch_size"
      }
    ],
    "seed": [
      {
        "node": "6",
        "input": "seed"
      }
    ],
    "steps": [
      {
        "node": "6",
        "input": "steps"
      }
    ],
    "guidance": [
      {
        "node": "6",
        "input": "cfg"
      }
    ],
    "lumina_sampler": [
      {
        "node": "6",
        "input": "sampler_name"
      }
    ],
    "lumina_scheduler": [
      {
        "node": "6",
        "input": "scheduler"
      }
    ],
    "lumina_denoise": [
      {
        "node": "6",
        "input": "denoise"
      }
    ]
  },
  "uploads": {},
  "outputs": [
    {
      "node": "8",
      "type": "image",
      "extension": ".png",
      "mime": "image/png"
    }
  ],
  "notes": [
    "The existing prompt field maps to CLIPTextEncodeLumina2 user_prompt with the superior Lumina system prompt.",
    "The existing negative prompt field maps to a regular CLIPTextEncode negative conditioning node.",
    "The workflow follows Comfy's Lumina basic example with AuraFlow sampling shift and the all-in-one Lumina checkpoint."
  ]
}
