        "disconnects": [
          {
            "node": "22",
            "input": "latent"
          },
          {
            "node": "23",
            "input": "latent"
          }
        ]
      }
    ],
    "images[2]": [
      {
        "node": "24",
        "input": "image",
        "type": "input",
        "optional": true,
        "disconnects": [
          {
            "node": "27",
            "input": "latent"
          },
          {
            "node": "28",
            "input": "latent"
          }
        ]
      }
    ]
  },
  "unmapped_ui_parameters": {
    "frames": "The existing image-plugin frame control is preserved by the surrounding UI but this workflow emits one PNG per generate call.",
    "multi_images[3..8]": "The old FLUX multi-image UI can expose up to nine slots. This certified graph submits the first three references and records a usage note when more are selected.",
    "strength": "FLUX.2 Dev multi-reference generation does not expose a denoise/strength input in this graph.",
    "custom_loras": "No hosted Turbo LoRA is loaded in production."
  },
  "outputs": [
    {
      "node": "18",
      "type": "image",
      "extension": ".png",
      "mime": "image/png"
    }
  ]
}
