      {
        "node": "14",
        "input": "steps"
      }
    ],
    "width": [
      {
        "node": "2",
        "input": "width"
      },
      {
        "node": "14",
        "input": "width"
      },
      {
        "node": "15",
        "input": "width"
      },
      {
        "node": "20",
        "input": "width"
      },
      {
        "node": "25",
        "input": "width"
      }
    ],
    "height": [
      {
        "node": "2",
        "input": "height"
      },
      {
        "node": "14",
        "input": "height"
      },
      {
        "node": "15",
        "input": "height"
      },
      {
        "node": "20",
        "input": "height"
      },
      {
        "node": "25",
        "input": "height"
      }
    ],
    "batch": [
      {
        "node": "15",
        "input": "batch_size"
      }
    ]
