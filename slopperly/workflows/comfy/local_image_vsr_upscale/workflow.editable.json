{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "local_vsr_input.png"
    },
    "_meta": {
      "title": "Load Image"
    }
  },
  "2": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "RealESRGAN_x4.pth"
    },
    "_meta": {
      "title": "Load Real-ESRGAN Upscale Model"
    }
  },
  "3": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "2",
        0
      ],
      "image": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Upscale Image With Model"
    }
  },
  "4": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "3",
        0
      ],
      "upscale_method": "bicubic",
      "width": 1920,
      "height": 1080,
      "crop": "center"
    },
    "_meta": {
      "title": "Resize To Requested Resolution"
    }
  },
  "5": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "filename_prefix": "slopperly_local_image_vsr"
    },
    "_meta": {
      "title": "Save Upscaled Image"
    }
  }
}
